        "rammed",
        "allision"
      ],
      "default_space": "FPR",
      "severity": "CRITICAL",
      "actions": [
        {
          "id": "C1",
          "rank": 1,
          "owner": "Bridge",
          "title": "Sound the collision alarm",
          "doc": "COL",
          "para": "2.1",
          "quote": "Sound the collision alarm and pass the word on the general announcing system.",
          "needs": []
        },
        {
          "id": "C2",
          "rank": 2,
          "owner": "All Repair Lockers",
          "title": "Set maximum watertight integrity",
          "doc": "COL",
          "para": "2.2",
          "quote": "Set maximum watertight integrity throughout the ship.",
          "needs": []
        },
        {
          "id": "C3",
          "rank": 3,
          "owner": "Repair 2",
          "title": "Report damage, flooding and injuries",
          "doc": "COL",
          "para": "2.3",
          "quote": "Report damage, flooding and injuries to Damage Control Central.",
          "needs": []
        },
        {
          "id": "C4",
          "rank": 4,
          "owner": "Repair 2",
          "title": "Start Main Drainage Eductor 2",
          "doc": "COL",
          "para": "2.4",
          "quote": "Start Main Drainage Eductor 2 to dewater the affected space.",
          "needs": [
            "MDE-2"
          ]
        },
        {
          "id": "C5",
          "rank": 5,
          "owner": "Repair 2",
          "title": "Rig the portable dewatering pump",
          "doc": "COL",
          "para": "2.5",
          "quote": "If Main Drainage Eductor 2 is unavailable, rig the portable dewatering pump.",
          "needs": [
            "PDP-1"
          ],
          "only_if_blocked": "C4"
        },
        {
          "id": "C6",
          "rank": 6,
          "owner": "Repair 3",
          "title": "Set flooding boundaries",
          "doc": "COL",
          "para": "2.6",
          "quote": "Set flooding boundaries around the affected space.",
          "needs": [],
          "status": "boundaries"
        },
        {
          "id": "C7",
          "rank": 7,
          "owner": "Damage Control Central",
          "title": "Muster all hands",
          "doc": "COL",
          "para": "2.7",
          "quote": "Muster all hands and report missing personnel to the bridge.",
          "needs": []
        },
        {
          "id": "C5B",
          "rank": 5.5,
          "owner": "Repair 2",
          "title": "Start Eductor 1 through the cross-connect",
          "doc": "COL",
          "para": "2.5.1",
          "quote": "If the portable dewatering pump is unavailable, start Eductor 1 and align it through the cross-connect.",
          "needs": [
            "EDU-1"
          ],
          "only_if_blocked": "C5"
        }
      ],
      "comms": [
        {
          "channel": "1MC Announcement",
          "text": "Collision, collision, collision. Flooding reported in {location}. All hands set maximum watertight integrity. Muster and report.",
          "speaker": "Bridge"
        },
        {
          "channel": "Report to Bridge",
          "text": "Bridge, DCC. Flooding in {location}. Boundaries being set. {status} Will report rate of flooding.",
          "speaker": "Damage Control Central"
        },
        {
          "channel": "Report to Repair 2",
          "text": "Repair 2, DCC. Investigate {location}. Report damage, flooding and injuries. {status}",
          "speaker": "Damage Control Central"
        }
      ],
      "injects": [
        {
          "id": "pdp",
          "label": "DEWATERING PUMP FAILS",
          "equipment": "PDP-1"
        }
      ],
      "always": true
    },
