  "casualties": [
    {
      "id": "main-space-fire",
      "name": "Main Space Fire",
      "button": "FIRE",
      "sample_report": "Fire in main engine room 1, heavy smoke near the fuel pumps",
      "keywords": [
        "fire",
        "flames",
        "flame",
        "smoke",
        "burning",
        "flashover"
      ],
      "severity": "CRITICAL",
      "actions": [
        {
          "id": "A1",
          "rank": 1,
          "owner": "Central Control",
          "title": "Report the fire and sound the alarm",
          "doc": "CCP",
          "para": "3.1",
          "quote": "Report the fire to Central Control and sound the alarm.",
          "needs": []
        },
        {
          "id": "A2",
          "rank": 2,
          "owner": "Central Control",
          "title": "Stop fuel to the space",
          "doc": "CCP",
          "para": "3.2",
          "quote": "Stop fuel to the affected space.",
          "needs": [
            "FOSP-1"
          ],
          "status": "fuel"
        },
        {
          "id": "A3",
          "rank": 3,
          "owner": "Central Control",
          "title": "Secure ventilation",
          "doc": "CCP",
          "para": "3.3",
          "quote": "Secure ventilation to the affected space before setting boundaries.",
          "needs": [
            "VENT-1"
          ],
          "status": "ventilation"
        },
        {
          "id": "A4",
          "rank": 4,
          "owner": "Repair 5",
          "title": "Start Fire Pump 2",
          "doc": "CCP",
          "para": "3.4",
          "quote": "Start Fire Pump 2 to pressurize the firemain for the affected zone.",
          "needs": [
            "FP-2"
          ],
          "status": "firemain"
        },
        {
          "id": "A5",
          "rank": 5,
          "owner": "Repair 5",
          "title": "Start Fire Pump 3, open cross-connect",
          "doc": "CCP",
          "para": "3.5",
          "quote": "If Fire Pump 2 is unavailable, start Fire Pump 3 and open the firemain cross-connect valve.",
          "needs": [
            "FP-3"
          ],
          "only_if_blocked": "A4",
          "status": "firemain"
        },
        {
          "id": "A6",
          "rank": 6,
          "owner": "Electrical Watch",
          "title": "Shift electrical load",
          "doc": "CCP",
          "para": "3.6",
          "quote": "Shift electrical load away from generators in the affected space.",
          "needs": [
            "GTG-1"
          ]
        },
        {
          "id": "A7",
          "rank": 7,
          "owner": "Repair 2",
          "title": "Set fire boundaries, all six sides",
          "doc": "CCP",
          "para": "3.7",
          "quote": "Set fire boundaries on all six sides of the affected space.",
          "needs": [],
          "status": "boundaries"
        },
        {
          "id": "A8",
          "rank": 8,
          "owner": "Damage Control Central",
          "title": "Hold agent until space is isolated",
          "doc": "CCP",
          "para": "3.8",
          "quote": "Do not release the fixed extinguishing agent until all personnel are accounted for and the space is confirmed isolated.",
          "needs": []
        },
        {
          "id": "X1",
          "rank": 9,
          "owner": "Repair 2",
          "title": "Flood the space immediately",
          "doc": "CCP",
          "para": "3.9",
          "quote": "Immediately flood the space with seawater to extinguish the fire.",
          "needs": []
        },
        {
          "id": "A5B",
          "rank": 5.5,
          "owner": "Repair 5",
          "title": "Start the Emergency Fire Pump",
          "doc": "CCP",
          "para": "3.5.1",
          "quote": "If Fire Pump 3 is also unavailable, start the Emergency Fire Pump and align it to the firemain.",
          "needs": [
            "EFP-1"
          ],
          "only_if_blocked": "A5",
          "status": "firemain"
        }
      ],
      "comms": [
        {
          "channel": "1MC Announcement",
          "text": "Fire, fire, fire. Fire in {location}. Away the duty fire team. All hands stand clear of {location}.",
          "speaker": "Bridge"
        },
        {
          "channel": "Report to Bridge",
          "text": "Bridge, Central Control. Fire in {location}. Fuel and ventilation being secured. {status} Will report when boundaries are set.",
          "speaker": "Central Control"
        },
        {
          "channel": "Report to DCC",
          "text": "DCC, Central Control. Class of fire to be confirmed in {location}. Set boundaries on all six sides. {status}",
          "speaker": "Central Control"
        }
      ],
      "injects": [
        {
          "id": "fp3",
          "label": "FIRE PUMP 3 FAILS",
          "equipment": "FP-3"
        }
      ],
      "hazards": [
        "fire",
        "smoke"
      ],
      "spaces": [
        "MER1"
      ]
    },
    {
      "id": "collision",
      "name": "Collision and Flooding",
      "button": "COLLISION",
      "sample_report": "Collision forward, flooding in the forward pump room",
      "keywords": [
        "collision",
